# ----------------------------------------
# CACHE CONTROL
# ----------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ----------------------------------------
# GZIP COMPRESSION
# ----------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff font/ttf
</IfModule>

# ----------------------------------------
# BROTLI (si está disponible en Hostinger)
# ----------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS font/woff2 font/woff font/ttf
</IfModule>
